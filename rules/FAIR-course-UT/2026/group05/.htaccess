RewriteEngine on


# Ontology
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^ont$ https://gitlab.utwente.nl/s2987716/fair-project/-/raw/main/ontology/shelter_dogs_ont.ttl [R=303,L]
RewriteRule ^ont$ https://gitlab.utwente.nl/s2987716/fair-project/-/blob/main/ontology/shelter_dogs_ont.ttl [R=303,L]

# FAIRified data
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^data$ https://gitlab.utwente.nl/s2987716/fair-project/-/raw/main/data/shelter_dogs_fair.ttl [R=303,L]
RewriteRule ^data$ https://gitlab.utwente.nl/s2987716/fair-project/-/blob/main/data/shelter_dogs_fair.ttl [R=303,L]

# Original data
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^data/original$ https://gitlab.utwente.nl/s2987716/fair-project/-/raw/main/data/shelter_dogs_original.csv [R=303,L]
RewriteRule ^data/original$ https://gitlab.utwente.nl/s2987716/fair-project/-/blob/main/data/shelter_dogs_original.csv [R=303,L]

# Metadata SHACL schema
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^metadata/schema$ https://gitlab.utwente.nl/s2987716/fair-project/-/raw/main/metadata/schema.ttl [R=303,L]
RewriteRule ^metadata/schema$ https://gitlab.utwente.nl/s2987716/fair-project/-/blob/main/metadata/schema.ttl [R=303,L]

# Dataset metadata
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^metadata/dataset$ https://gitlab.utwente.nl/s2987716/fair-project/-/raw/main/metadata/dataset.ttl [R=303,L]
RewriteRule ^metadata/dataset$ https://gitlab.utwente.nl/s2987716/fair-project/-/blob/main/metadata/dataset.ttl [R=303,L]

# FAIRified data distribution
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^metadata/distribution/fair$ https://gitlab.utwente.nl/s2987716/fair-project/-/raw/main/metadata/distribution_fair.ttl [R=303,L]
RewriteRule ^metadata/distribution/fair$ https://gitlab.utwente.nl/s2987716/fair-project/-/blob/main/metadata/distribution_fair.ttl [R=303,L]


# Original data distribution
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^metadata/distribution/original$ https://gitlab.utwente.nl/s2987716/fair-project/-/raw/main/metadata/distribution_original.ttl [R=303,L]
RewriteRule ^metadata/distribution/original$ https://gitlab.utwente.nl/s2987716/fair-project/-/blob/main/metadata/distribution_original.ttl [R=303,L]

# Anything else: the landing page.
RewriteRule ^$ https://gitlab.utwente.nl/s2987716/fair-project [R=302,L]
