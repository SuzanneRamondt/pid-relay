RewriteEngine On

# Group 25
# Original dataset
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^data/originalcsv$ https://github.com/SuzanneRamondt/SmokingHealth/blob/main/main/data/original/health_dataset.csv [R=303,L]

RewriteRule ^data/originalcsv$ https://raw.githubusercontent.com/SuzanneRamondt/SmokingHealth/main/main/data/original/health_dataset.csv [R=303,L]

# Fairified dataset
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^data/rdf$ https://github.com/SuzanneRamondt/SmokingHealth/blob/main/main/data/rdf/smoking-dataset.ttl [R=303,L]

RewriteRule ^data/rdf$ https://raw.githubusercontent.com/SuzanneRamondt/SmokingHealth/main/main/data/rdf/smoking-dataset.ttl [R=303,L]

# Metadata CSV (original)
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^metadata/schema/csv/?$ https://github.com/SuzanneRamondt/SmokingHealth/blob/main/main/metadata/schema/smoking-distribution-metadata-schema.ttl [R=303,L]

RewriteRule ^metadata/schema/csv/?$ https://raw.githubusercontent.com/SuzanneRamondt/SmokingHealth/main/main/metadata/schema/smoking-distribution-metadata-schema.ttl [R=303,L]


# Metadata schema
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^metadata/schema/schema/?$ https://github.com/SuzanneRamondt/SmokingHealth/blob/main/main/metadata/schema/smoking-metadata-schema.ttl [R=303,L]

RewriteRule ^metadata/schema/schema/?$ https://raw.githubusercontent.com/SuzanneRamondt/SmokingHealth/main/main/metadata/schema/smoking-metadata-schema.ttl [R=303,L]


# Metadata RDF
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^metadata/schema/rdf/?$ https://github.com/SuzanneRamondt/SmokingHealth/blob/main/main/metadata/schema/smoking-rdf-distribution-schema.ttl [R=303,L]

RewriteRule ^metadata/schema/rdf/?$ https://raw.githubusercontent.com/SuzanneRamondt/SmokingHealth/main/main/metadata/schema/smoking-rdf-distribution-schema.ttl [R=303,L]

# Ontology
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^ont$ https://github.com/SuzanneRamondt/SmokingHealth/blob/main/main/ontology/project_smoking_ontology.ttl [R=303,L]

RewriteRule ^ont$ https://raw.githubusercontent.com/SuzanneRamondt/SmokingHealth/main/main/ontology/project_smoking_ontology.ttl [R=303,L]

# Namespace root: the project repository.
RewriteRule ^$ https://github.com/SuzanneRamondt/SmokingHealth [R=302,L]